# Server
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://vault.prahladsingh.in

# MongoDB (Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sharevault

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Uploads
MAX_FILE_SIZE_USER=524288000

# MinIO — object storage (replaces local uploads/ and videos/ folders)
# In production MinIO runs on the same VPS as the API, so endpoint is
# localhost and useSSL is false; Nginx/TLS is only in front of the API
# itself, MinIO is never exposed directly to the internet.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-and-make-it-long
MINIO_FILES_BUCKET=sharevault-files
MINIO_VIDEOS_BUCKET=sharevault-videos
